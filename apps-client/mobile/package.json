{
  "name": "@client/mobile",
  "main": "index.js",
  "version": "2.14.0",
  "scripts": {
    "dev": "node --env-file .env ./scripts/update-redirect.js && expo start --dev-client",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "open:ios": "xed ios",
    "open:android": "open -a /Applications/Android\\ Studio.app android",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --clean --platform android",
    "prebuild:ios": "expo prebuild --clean --platform ios",
    "build:android": "eas build -p android --profile preview --local",
    "fastlane:setup": "bash ./fastlane/setup.sh",
    "fastlane:android": "bun run prebuild:android && bun run fastlane:setup && cd android && fastlane beta",
    "fastlane:ios": "bun run prebuild:ios && bun run fastlane:setup && cd ios && fastlane beta",
    "fastlane:android:prod": "bun run prebuild:android && bun run fastlane:setup && cd android && fastlane production",
    "fastlane:ios:prod": "bun run prebuild:ios && bun run fastlane:setup && cd ios && fastlane production"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans-thai": "^0.4.2",
    "@expo-google-fonts/noto-sans-thai-looped": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@pple-today/api-client": "workspace:^",
    "@pple-today/ui": "workspace:^",
    "@react-native-firebase/analytics": "27.1.0",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/messaging": "27.1.0",
    "@react-native-firebase/remote-config": "27.1.0",
    "@rn-primitives/radio-group": "^1.2.0",
    "@rn-primitives/toggle-group": "^1.2.0",
    "@tanstack/react-form": "^1.14.1",
    "@tanstack/react-pacer": "^0.16.4",
    "@tanstack/react-query": "^5.81.5",
    "dayjs": "^1.11.13",
    "expo": "^58.0.23",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-notification-service-extension-plugin": "^1.0.2",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-scroll-forwarder": "workspace:^",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-tracking-transparency": "~58.0.2",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "html-entities": "^2.6.0",
    "immer": "^10.2.0",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^0.514.0",
    "nativewind": "^4.2.7",
    "node-forge": "^1.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-pager-view": "9.0.7",
    "react-native-react-query-devtools": "^1.5.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-tab-view": "^4.3.4",
    "react-native-web": "^0.21.4",
    "react-native-webview": "16.0.2",
    "react-native-worklets": "0.13.0",
    "react-query-kit": "^3.3.1",
    "semver": "^7.6.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@api/backoffice": "workspace:^",
    "@babel/core": "^7.25.2",
    "@pple-today/project-config": "workspace:^",
    "@tanstack/eslint-plugin-query": "^5.81.2",
    "@types/node-forge": "^1.3.14",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/semver": "^7.5.8",
    "babel-preset-expo": "~58.0.24",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-native-svg-transformer": "^1.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-webview"
      ]
    }
  }
}
