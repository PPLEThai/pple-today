enum NotificationLinkType {
  MINI_APP
  IN_APP_NAVIGATION
  EXTERNAL_BROWSER
}

enum NotificationTokenPlatform {
  IOS
  ANDROID
}

model UserNotificationToken {
  token  String @id
  userId String

  // The send path builds a different FCM payload per platform, so it has to
  // know which one a token belongs to. Null for tokens registered before this
  // change — and unknown-platform tokens keep the payload they already
  // understand, which is what makes "no backfill" safe.
  platform NotificationTokenPlatform?

  // The client asserts, on every registration, that this build can render a
  // branded notification from a data-only message. False for every token
  // registered by an older build, which is what keeps those installs on the
  // proven `notification` payload.
  supportsAppBranding Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum NotificationInAppType {
  POST
  POLL
  TOPIC
  USER
  ANNOUNCEMENT
  ELECTION
  HASHTAG
  OFFICIAL
  ACTIVITY
  ANNOUNCEMENT_LIST
  NOTIFICATION_LIST
  SEARCH
  PROFILE
  MY_ACTIVITIES
  RECENT_ACTIVITIES
  FOLLOW
  PARTICIPATION
  TOPIC_SUGGESTION
  USER_SUGGESTION
  ELECTION_VOTE
  // Not a navigation entity: marks a notification as a Beta invite so the
  // notification centre renders the accept/decline inbox inline, and a push tap
  // lands on the แอป tab where that same inbox lives.
  MINI_APP_INVITE
}

model Notification {
  id               String                @id @default(cuid())
  title            String
  message          String
  image            String?
  actionButtonText String?
  linkType         NotificationLinkType?
  linkDestination  String?

  linkInAppType NotificationInAppType?
  linkInAppId   String?

  linkBypassNotificationCenter Boolean?

  isBroadcast Boolean  @default(false)
  roles       String[]
  provinces   String[]
  districts   String[]

  // The app this notification came from. Null = PPLE Today itself: every
  // pre-existing row, and every send from a legacy unbound key.
  //
  // A foreign key rather than a snapshot of the name and icon, so a rename or a
  // new icon re-labels the app's whole notification history — a reader asks
  // "which app is this?", not "what was it called in March". MiniApp rows are
  // never hard-deleted (retire is a soft-delete), so a retired app's old
  // notifications keep resolving.
  miniAppId String?
  miniApp   MiniApp? @relation(fields: [miniAppId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentNotifications UserNotification[]
  phoneNumbers      NotificationPhoneNumber[]

  @@index([miniAppId])
}

model NotificationPhoneNumber {
  notificationId String
  phoneNumber    String

  notification Notification @relation(fields: [notificationId], references: [id])

  @@id([notificationId, phoneNumber])
  @@index([phoneNumber])
}

model UserNotification {
  userId         String
  notificationId String

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id])

  @@id([userId, notificationId])
  @@index([notificationId])
  @@index([userId])
}

// Who issued a notification key, which is what decides the key's *capability*
// — separately from `miniAppId`, which decides the app it speaks for.
//
// Originally this was derived from `MiniApp.source`: a key bound to a Builder
// App was, by definition, that Builder's key. That stopped being true once the
// central team needed to send to a Builder App's users with a richer audience
// than the app itself may name. Such a key is bound to a `PLATFORM` app but was
// issued by a vetted admin, so the app's source can no longer answer for it.
//
// `ADMIN` — issued from the admin portal (and every key that predates the
// platform provisioner). Full raw-targeting capability, never metered.
// `PLATFORM` — provisioned by the platform alongside a Builder App, on the
// Builder's behalf. Confined to the audience-bound path and metered.
enum NotificationApiKeySource {
  ADMIN
  PLATFORM
}

model NotificationApiKey {
  id     String  @id @default(cuid())
  name   String
  apiKey String  @unique
  active Boolean @default(true)

  // App-bound key. Null = legacy central-team key with today's raw
  // phone-number behaviour, unchanged. Set for the per-app key the platform
  // provisions with each Builder App; retire deactivates it via this binding.
  //
  // Binding is attribution: it says whose name and icon the notification
  // carries, not who the key may reach. `source` decides that.
  miniAppId String?
  miniApp   MiniApp? @relation(fields: [miniAppId], references: [id])

  // Defaults to ADMIN because that is what an admin-portal create is, and what
  // every pre-existing unbound key has always been. The provisioner sets
  // PLATFORM explicitly; the migration backfilled it for the keys it had
  // already created against Builder Apps.
  source NotificationApiKeySource @default(ADMIN)

  // Sends allowed per calendar day (Asia/Bangkok), metered against
  // NotificationApiKeyUsageLog via a transactional claim that locks this row.
  // The default is the Builder App Resource Limit; raises are approved on the
  // platform (LimitRequest) and applied here. Legacy central-team keys are never
  // metered, so this column is inert for them.
  dailyQuota Int @default(1000)

  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  usageLogs NotificationApiKeyUsageLog[]

  @@index([active, apiKey])
  // Serves both "this app's keys" (admin portal) and "this app's provisioned
  // key" (quota read/write), which is always qualified by source.
  @@index([miniAppId, source])
}

model NotificationApiKeyUsageLog {
  id                   String   @id @default(cuid())
  notificationApiKeyId String
  usedAt               DateTime @default(now())
  body                 Json

  // What this call debits: the reach it *requested*, not the reach it achieved.
  // A direct send costs one unit per named recipient (delivered or not, after
  // entries resolving to the same person collapse); a broadcast costs the
  // audience size at send time. The quota is therefore denominated in
  // deliveries rather than calls, and the daily budget is a `SUM` over this
  // column rather than a row count.
  //
  // Defaults to 1, which is exactly what a pre-existing row meant when a row
  // was a call — so no backfill, and the raw-targeting path (never metered)
  // keeps writing its audit rows without naming a number.
  units Int @default(1)

  // Client-supplied retry token, unique per key. A call that repeats one is
  // answered from this row instead of being delivered and charged twice, which
  // is what makes retrying after a timeout safe. Null for calls that supplied
  // none — many such rows per key, hence a nullable unique rather than a
  // required one.
  idempotencyKey String?

  notificationApiKey NotificationApiKey @relation(fields: [notificationApiKeyId], references: [id])

  @@unique([notificationApiKeyId, idempotencyKey])
  @@index([notificationApiKeyId])
  @@index([usedAt])
  // Serves the daily-quota sum, which always asks "this key, since midnight".
  @@index([notificationApiKeyId, usedAt])
}
