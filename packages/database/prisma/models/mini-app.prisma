enum MiniAppTier {
  DRAFT
  BETA
  LIVE
}

enum MiniAppSource {
  ADMIN
  PLATFORM
}

model MiniApp {
  id    String  @id @default(cuid())
  // The App Slug. Never renamed: stored notification links and the platform
  // relay URL (`/apps/<slug>/notification-response`) are built from it. A
  // Link Name is a second name, stored on MiniAppLinkName, not a new slug.
  slug  String  @unique
  name  String
  icon  String? // Public icon URL (legacy rows may still hold a base64 data URI)
  order Int     @default(0)

  // One verb-first line saying what the app does (≤ 60 chars), shown under the
  // name and searched by the แอปฯ tab. Required by the admin and platform forms,
  // not here, so existing rows need no backfill.
  tagline String?

  clientId     String
  clientUrl    String
  requiresAuth Boolean @default(true)

  // Builder-app lifecycle. Existing rows are central-team apps that are already
  // live, so the defaults (LIVE/ADMIN, no owner) keep them behaving exactly as
  // before. Platform-provisioned Builder apps start as DRAFT/PLATFORM with an
  // ownerSub (the Builder's PPLE ID `sub`) so only the owner sees them.
  tier     MiniAppTier   @default(LIVE)
  source   MiniAppSource @default(ADMIN)
  ownerSub String? // Builder's PPLE ID sub; set only when source = PLATFORM

  // The app's Collaborators (PPLE ID `sub`s), synced from the platform database
  // which authoritatively owns them. today-v2 keeps this copy only so a Draft or
  // Beta app is *listed* in PPLE Today for its Collaborators, not the Owner
  // alone — the web membership door reads builders from the platform, so the
  // listing was the inconsistent side. Empty for central-team (ADMIN) rows.
  collaboratorSubs String[] @default([])

  // A LIVE app that is listed to no one yet stays reachable by its link — the
  // `unlisted` visibility mode, distinct from empty `miniAppRoles` (which means
  // "listed to everyone"). Ignored for DRAFT/BETA, which are already restricted.
  unlisted Boolean @default(false)

  // Zitadel's internal app id (distinct from the OIDC clientId), recorded when
  // the platform provisions the app so retire can delete the OIDC app. Null for
  // central-team rows, whose Zitadel apps are managed through the admin API.
  zitadelAppId String?

  // Retire is a soft-delete: the platform deletes the Zitadel app and
  // deactivates the notification key, then stamps this. Retired apps are hidden
  // from the mini-app list but the row (and its App User registry) is kept for
  // audit. Null for every live app.
  retiredAt DateTime?

  // When the app first went Live. Stamped once, on the first promotion to LIVE
  // (or at creation for central-team apps, which start Live). Null for apps
  // that were Live before this column existed, so they never count as new.
  publishedAt DateTime?

  // Where answers to this app's interactive notifications are POSTed.
  // ADMIN apps only, set in the admin portal. PLATFORM apps ignore it and
  // always deliver through the platform at the predefined path.
  notificationCallbackUrl                     String?
  // HMAC key for the callback signature. Generated when a URL is first set,
  // revealed once, rotatable. Stored encrypted: it must be usable to sign, so it
  // cannot be hashed like the notification key.
  notificationCallbackSecret                  String?
  // The secret replaced by the last rotation. Requests are signed with both
  // until notificationCallbackPreviousSecretExpiresAt (24 h), so an app can
  // switch keys without rejecting deliveries in flight. Encrypted like the
  // current secret.
  notificationCallbackPreviousSecret          String?
  notificationCallbackPreviousSecretExpiresAt DateTime?

  // The slug of the pple-platform Bridge this ADMIN app is connected to; null
  // when it is not connected. Non-null IS the connected state. The platform
  // connects/disconnects through `/platform/admin-mini-apps/:id/bridge`. While
  // connected, every Notification Response goes to the platform relay keyed by
  // this slug (overriding the callback URL above, which is left stored so a
  // disconnect falls back to it), and a PLATFORM-source notification key bound
  // to the app is held by the platform. Unique: one Bridge, one mini-app.
  platformBridgeSlug String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  banners Banner[]

  linkNames             MiniAppLinkName[]
  miniAppRoles          MiniAppRole[]
  appUsers              MiniAppUser[]
  notificationApiKeys   NotificationApiKey[]
  notifications         Notification[]
  invites               MiniAppInvite[]
  notificationResponses NotificationResponse[]
}

enum MiniAppInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A Builder's invitation for one tester to try their BETA app.
//
// An invite is *addressed* by phone number but *bound* to an account: the phone
// number exists only to deliver the invitation and to let the invitee find it,
// while `userId` is written once at accept time and is the only thing listing
// eligibility matches on. That split is deliberate — a tester who later changes
// their phone number keeps the access they consented to.
//
// The invite cap is enforced in the service (passed into a transactional
// repository claim), not the schema, so a Platform Admin can raise it per app
// later without a migration.
model MiniAppInvite {
  miniAppId String
  miniApp   MiniApp @relation(fields: [miniAppId], references: [id])

  phoneNumber String // E.164-normalised; a delivery address, never the key to access

  status MiniAppInviteStatus @default(PENDING)
  userId String? // PPLE ID `sub` of the invitee (same identity as User.id), bound at accept time
  user   User?               @relation(fields: [userId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?

  @@id([miniAppId, phoneNumber])
  // Listing eligibility reads accepted invites by account…
  @@index([userId])
  // …while the invitee's own inbox finds pending ones by their number.
  @@index([phoneNumber])
}

// One row per (mini app, user) the first time that user opens the app. Opening
// a mini app for the first time registers the person as that app's App User —
// the consent boundary for audience-bound notifications and the source of the
// Console's per-app user count. Registration is idempotent on the composite
// key: repeat opens touch nothing.
model MiniAppUser {
  miniAppId String
  miniApp   MiniApp @relation(fields: [miniAppId], references: [id])

  userId        String // PPLE ID `sub` of the App User (same identity as User.id)
  user          User     @relation(fields: [userId], references: [id])
  firstOpenedAt DateTime @default(now())

  @@id([miniAppId, userId])
}

model MiniAppRole {
  role String

  miniAppId String
  miniApp   MiniApp @relation(fields: [miniAppId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([role, miniAppId])
}

/// A second name in the Today Link (`donate` in miniapp.peoplesparty.or.th/donate).
///
/// `name` is stored lowercase and is unique across every mini-app. It must also
/// not equal any `MiniApp.slug` (any case). Prisma cannot express a unique
/// constraint across two tables, so that half is a trigger in the migration
/// that created this table. `canonicalForId` is the owning mini-app id when
/// this row is the canonical name, and null when the name was replaced and is
/// still held. The unique column gives each mini-app at most one canonical
/// name; Postgres treats nulls as distinct, so every replaced name can stay.
/// Deleting the mini-app cascades these rows. Retire is a soft-delete, so it
/// deletes them itself — a retired app's Link Name must 404, while the platform
/// keeps its own copy of the hold.
model MiniAppLinkName {
  name           String  @id
  miniAppId      String
  miniApp        MiniApp @relation(fields: [miniAppId], references: [id], onDelete: Cascade)
  canonicalForId String? @unique

  @@index([miniAppId])
}
