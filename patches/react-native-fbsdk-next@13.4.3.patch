diff --git a/ios/RCTFBSDK/login/RCTFBSDKLoginManager.m b/ios/RCTFBSDK/login/RCTFBSDKLoginManager.m
index 3ffb92ff78b9e1fce566f3a4dfbd439eee9e74da..981d1ecbb07ef16a6a67775cb072d3a2a36c6938 100644
--- a/ios/RCTFBSDK/login/RCTFBSDKLoginManager.m
+++ b/ios/RCTFBSDK/login/RCTFBSDKLoginManager.m
@@ -77,17 +77,25 @@ + (BOOL)requiresMainQueueSetup
     };
     FBSDKLoginConfiguration *configuration;
     FBSDKLoginTracking tracking = [loginTracking  isEqualToString: @"limited"] ? FBSDKLoginTrackingLimited : FBSDKLoginTrackingEnabled;
+    // PPLE patch: FBSDK 18 turns on Fast App Switch by default, which hands login
+    // to the Facebook app; its in-app browser then asks users to sign in again
+    // even when they are signed in to the Facebook app. Disable it so login
+    // runs in the system browser sheet (ASWebAuthenticationSession), which
+    // shares Safari's facebook.com session.
+    FBSDKAppSwitch appSwitch = FBSDKAppSwitchDisabled;
 
     if ( ( ![nonce isEqual:[NSNull null]] ) && ( [nonce length] != 0 ) ) {
         configuration =
         [[FBSDKLoginConfiguration alloc] initWithPermissions:permissions
                                                     tracking: tracking
                                                        nonce:nonce
+                                                   appSwitch:appSwitch
          ];
     } else {
         configuration =
         [[FBSDKLoginConfiguration alloc] initWithPermissions:permissions
                                                     tracking: tracking
+                                                   appSwitch:appSwitch
          ];
     }
 
